<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiToMcp.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>OpenApiToMcp</Authors>
    <Description>ASP.NET Core integration for OpenApiToMcp. Provides DI registration and MCP server builder extensions to expose OpenAPI operations as MCP tools over HTTP (SSE) or stdio transports.</Description>
    <PackageTags>openapi;mcp;model-context-protocol;aspnetcore;ai;tools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <ProjectReference Include="..\OpenApiToMcp.Core\OpenApiToMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
