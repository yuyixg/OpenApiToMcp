<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>OpenApiToMcp.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>OpenApiToMcp</Authors>
    <Description>Core library for converting OpenAPI specifications to MCP (Model Context Protocol) tools. Supports OpenAPI v3.x with overlay application, operation filtering, and parameter validation.</Description>
    <PackageTags>openapi;mcp;model-context-protocol;ai;tools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.5.3" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.5.3" />
    <PackageReference Include="ModelContextProtocol.Core" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
